{
  "name": "@caleo/core",
  "version": "0.0.1",
  "description": "Caleo graphql server",
  "main": "src/index.ts",
  "scripts": {
    "deploy": "npm run generate && sls deploy",
    "deploy:graphql": "npm run generate && sls deploy function -f graphql",
    "generate": "graphql-codegen --config codegen.yml",
    "gen": "npm run generate",
    "lint": "eslint ./src --ignore-pattern src/__generated__/*",
    "lint:fix": "eslint ./src --ignore-pattern src/__generated__/* --fix",
    "test": "TZ=UTC jest",
    "test:unit": "TZ=UTC jest",
    "test:assignments": "TZ=UTC jest --testPathPattern=assignments",
    "test:shifts": "TZ=UTC jest --testPathPattern=shifts"
  },
  "author": "danwakeem",
  "license": "MIT",
  "dependencies": {
    "@apollo/server": "^4.12.1",
    "@as-integrations/aws-lambda": "^3.1.0",
    "@aws-lambda-powertools/logger": "^2.20.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.812.0",
    "@aws-sdk/client-lambda": "^3.812.0",
    "@aws-sdk/client-pinpoint": "^3.812.0",
    "@aws-sdk/client-s3": "^3.812.0",
    "@aws-sdk/client-scheduler": "^3.812.0",
    "@aws-sdk/client-secrets-manager": "^3.812.0",
    "@aws-sdk/client-sfn": "^3.812.0",
    "@aws-sdk/s3-request-presigner": "^3.812.0",
    "@middy/core": "^6.3.0",
    "@slack/web-api": "^7.9.1",
    "aws-lambda": "^1.0.7",
    "dataloader": "^2.2.3",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "docusign-esign": "^8.1.0",
    "graphql": "^16.11.0",
    "jwt-decode": "^4.0.0",
    "libphonenumber-js": "^1.12.5",
    "lodash.chunk": "^4.2.0",
    "lodash.difference": "^4.5.0",
    "lodash.merge": "^4.6.2",
    "lodash.shuffle": "^4.2.0",
    "lodash.uniq": "^4.5.0",
    "lodash.uniqby": "^4.7.0",
    "mongodb": "^6.16.0",
    "saslprep": "^1.0.3",
    "web-push": "^3.6.7"
