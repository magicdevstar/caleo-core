    "aws-sdk-client-mock": "^4.1.0",
    "aws-sdk-client-mock-jest": "^4.1.0",
    "esbuild": "^0.25.4",
    "eslint": "^9.27.0",
    "graphql-tag": "^2.12.6",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.1.4",
    "serverless": "^3.38.0",
